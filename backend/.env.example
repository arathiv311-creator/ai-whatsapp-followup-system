# Copy to .env and fill in your local values.
# Never commit the real .env or real credentials.

DATABASE_URL=your_render_postgresql_url_here

SECRET_KEY=change-me-to-a-random-secret
DEBUG=True

REDIS_URL=redis://localhost:6379/0

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=whatsapp_verify_token

# Comma-separated list of origins allowed to call the API.
# If empty/omitted, a built-in list of localhost + Vercel origins is used.
CORS_ALLOWED_ORIGINS=

# Set True to allow any origin (not recommended for production).
CORS_ALLOW_ALL_ORIGINS=False

# True = route all sends through messaging/mock_whatsapp.py.
# Also used automatically when real WhatsApp credentials are missing.
# Keep False once real credentials are configured.
USE_MOCK_WHATSAPP=False

# Optional: prefix added to customer phones that have no country code.
# e.g. DEFAULT_COUNTRY_CODE=+91 for India
DEFAULT_COUNTRY_CODE=